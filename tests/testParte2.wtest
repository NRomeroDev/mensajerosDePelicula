import src.empresa.*
import src.mensajeros.*
import src.paquete.*
import src.vehiculos.*
import src.destinos.*

describe "Se hace una prueba de contratacion de 2 empleados, Neo y Jean Gray"{
    test "Se chequea que la planilla de empleados este vacia"{
        assert.equals([], empresa.listaEmpleados())
    }

    test "Se contrata a Neo"{
        empresa.contratarEmpleado(neo)
        assert.equals([neo], empresa.listaEmpleados())
    }

    test "Se contrata a Jean Gray"{
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        assert.equals([neo, jeanGray], empresa.listaEmpleados())
    }
}

describe "Se hace una prueba de despidos de empleados" {
    test "Se despide a Jean Gray"{
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray) // La planillas de empleados simepre inician vacias

        assert.equals([neo, jeanGray], empresa.listaEmpleados())

        empresa.despedirEmpleado(jeanGray)

        assert.equals([neo], empresa.listaEmpleados())

    }

    test "Se despide a Neo"{
        
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)

        assert.equals([neo, jeanGray], empresa.listaEmpleados())

        empresa.despedirEmpleado(neo)

        assert.equals([jeanGray], empresa.listaEmpleados())
    }

    test "Se despide a toda la planilla"{
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        assert.equals([neo, jeanGray, saraConnor], empresa.listaEmpleados())

        empresa.despedirTodos()

        assert.equals([], empresa.listaEmpleados())
    }
}

describe "se prueba si la mensajeria es grande, primero un casos donde no lo es, uno donde si" {
    test "se comprueba con una planilla de empleados vacia si es grande, no deberia serlo"{
        assert.equals(false, empresa.esMensajeriaGrande())
    }

    test "se comprueba con una planilla de empleados de un empleado si es grande, no deberia serlo"{
        empresa.contratarEmpleado(neo)

        assert.equals(false, empresa.esMensajeriaGrande())
    }

    test "se comprueba con una planilla de empleados de dos empleado si es grande, no deberia serlo"{
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)

        assert.equals(false, empresa.esMensajeriaGrande()) 
    }

    test "se comprueba con una planilla de empleados de tres empleado si es grande, deberia serlo"{
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        assert.equals(true, empresa.esMensajeriaGrande()) 
    }
}

describe "Se comprueba dos casos para entregar un paquete por el primer mensajero de la planilla,
            (Neo), uno donde si puede entregar el paquete y otro donde no"{

    test "Entrega de paquete a la Matrix por Neo, se espera que pueda hacerlo" {

        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        // Aclaro que Neo se inicia siempre con Credito, es decir puede llamar
        assert.equals(true, empresa.puedeEntregarPrimerEmpleado(matrix))
    }

    test "Entrega de paquete a la Matrix por Neo, se espera que no pueda hacerlo"{
        
        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        
        neo.puedeLlamar(false)
        assert.equals(false, empresa.puedeEntregarPrimerEmpleado(matrix))

    }

}

describe "Prueba de peso de ultimo empleado (Sara Connor) en diversos casos por su peso variable" {
    test "Se prueba caso de ultimo empleado, deberia pesar 100 kilos"{

        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        assert.equals(100, empresa.pesoDeUltimoEmpleado())
    }

    test "Se prueba caso de ultimo empleado, se aumentan 70 kilos, se espera  170 kilos"{

        empresa.contratarEmpleado(neo)
        empresa.contratarEmpleado(jeanGray)
        empresa.contratarEmpleado(saraConnor)

        saraConnor.peso(70)
        assert.equals(170, empresa.pesoDeUltimoEmpleado())
    }
}